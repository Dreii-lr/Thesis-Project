# ─── Application ──────────────────────────────────────────────────
APP_NAME="Thesis Project API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ─── Database ─────────────────────────────────────────────────────
# asyncpg DSN — must use postgresql+asyncpg:// scheme
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/thesis_db"

# ─── Firebase ─────────────────────────────────────────────────────
FIREBASE_TYPE="account"
FIREBASE_PROJECT_ID="project"
FIREBASE_PRIVATE_KEY_ID="Key"
FIREBASE_PRIVATE_KEY="KEY"
FIREBASE_CLIENT_EMAIL="email"
FIREBASE_CLIENT_ID="ID"
FIREBASE_AUTH_URI="URI"
FIREBASE_TOKEN_URI="URI"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=""
FIREBASE_CLIENT_X509_CERT_URL=""
FIREBASE_CLIENT_X509_CERT_URLFIREBASE_UNIVERSE_DOMAIN=""
FIREBASE_API_KEY=""
FIREBASE_APP_ID=""
# Small clock differences are tolerated; signature, issuer and revocation checks remain enabled.
FIREBASE_CLOCK_SKEW_SECONDS=5

# ─── Auth / Tokens ────────────────────────────────────────────────
JWT_SECRET_KEY="super-secret-jwt-key-change-in-production-12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
