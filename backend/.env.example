# ─── Application ──────────────────────────────────────────────────
APP_NAME="Thesis Project API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ─── Database ─────────────────────────────────────────────────────
# asyncpg DSN — must use postgresql+asyncpg:// scheme
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/thesis_db"

# ─── Firebase ─────────────────────────────────────────────────────
# Path to your downloaded Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH="firebase-credentials.json"
# Your Firebase project Web API Key (Project Settings > General)
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"

# ─── Auth / Tokens ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
